# EY Azure OpenAI Gateway
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENDPOINT=https://eyq-incubator.europe.fabric.ey.com/eyq/eu/api
OPENAI_API_VERSION=2024-02-15-preview
OPENAI_MODEL_NAME=gpt-4o

# Groq Configuration (if using)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Configuration (if using)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App Settings
LOG_LEVEL=INFO

# ── Authentification ────────────────────────────────────────────────────────
# AUTH_MODE=legacy   : JWT HS256 maison + users.json (bcrypt) — historique.
# AUTH_MODE=keycloak : délègue entièrement à Keycloak (Authorization Code + PKCE
#                       côté frontend), ce backend ne fait plus que valider les
#                       tokens via JWKS. Voir infra/keycloak/README.md pour monter
#                       Keycloak, et scripts/migrate_users_to_keycloak.py pour
#                       migrer les comptes de users.json.
AUTH_MODE=legacy

# JWT legacy (AUTH_MODE=legacy uniquement)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Keycloak (AUTH_MODE=keycloak uniquement)
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=lvmh-tickets
KEYCLOAK_FRONTEND_CLIENT_ID=ticket-dispatch-frontend
KEYCLOAK_BACKEND_CLIENT_ID=ticket-dispatch-backend
# Récupéré dans la console admin Keycloak après import du realm — voir
# infra/keycloak/README.md, section "Après le premier démarrage".
KEYCLOAK_BACKEND_CLIENT_SECRET=

# Ticket SSE court-terme (voir POST /agent/notifications/sse-ticket dans api.py) —
# secret backend-only, sans rapport avec les clés Keycloak.
SSE_TICKET_SECRET=change-me-to-a-long-random-string

# Origine autorisée en CORS pour le frontend (doit matcher exactement, avec credentials)
FRONTEND_ORIGIN=http://localhost:5173

# ── ServiceNow (webhooks entrant/sortant — voir src/servicenow.py) ──────────
# Compte technique ServiceNow (Basic Auth) utilisé pour relire/écrire les incidents
# et résoudre le sys_id d'un agent à partir de son email.
SN_INSTANCE=https://devXXXXX.service-now.com
SN_USER=your_servicenow_technical_account
SN_PASSWORD=your_servicenow_password

# ── Notifications Email (SMTP Gmail) ─────────────────────────────────────────
# Compte Gmail dédié à l'envoi des notifications.
# SMTP_PASSWORD doit être un "mot de passe d'application" Gmail (pas le mdp du compte).
# Pour en créer un : Compte Google → Sécurité → Validation en 2 étapes → Mots de passe d'application
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre_compte_notifications@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_SENDER_NAME=SmartDispatch
# URL du frontend — utilisée pour le lien "Voir mes tickets" dans l'email
PLATFORM_URL=http://localhost:5173
